# API base URL (no trailing slash)
VITE_API_URL=https://zuba-api.onrender.com

# Push notification API (after /api/notifications is deployed on your server)
# VITE_NOTIFICATIONS_API=true

# Firebase — Web app in project zuba-house-019
# All values must be from the SAME Firebase web app (Console → Project settings → Your apps).
# Wrong appId/apiKey pairs cause: auth/configuration-not-found (400 CONFIGURATION_NOT_FOUND).
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=zuba-house-019.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=zuba-house-019
VITE_FIREBASE_STORAGE_BUCKET=zuba-house-019.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
