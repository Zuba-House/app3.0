PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=
MONGODB_LOCAL_URI=
# Legacy aliases (optional)
MONGODB_URL=
MONGO_URI=

# JWT
SECRET_KEY_ACCESS_TOKEN=
SECRET_KEY_REFRESH_TOKEN=
JSON_WEB_TOKEN_SECRET_KEY=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=10

# API/Web URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
VENDOR_URL=http://localhost:3002
CLIENT_URL=http://localhost:3000
# Custom Vercel domains (e.g. https://mobileapp.zubahouse.com) are allowed via CORS in server/index.js
API_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000

# Cookie (set only for production domains, e.g. .zubahouse.com)
COOKIE_DOMAIN=

# SendGrid email
SENDGRID_API_KEY=
EMAIL_FROM=orders@zubahouse.com
EMAIL_SENDER_NAME=Zuba House
EMAIL=
EMAIL_USER=
ADMIN_EMAIL=sales@zubahouse.com
# Comma-separated emails that always get ADMIN on login (e.g. your Google account)
ADMIN_EMAILS=olivier.niyo250@gmail.com
TEST_EMAIL=

# Cloudinary
cloudinary_Config_Cloud_Name=
cloudinary_Config_api_key=
cloudinary_Config_api_secret=

# Google OAuth (mobile server-side exchange; native redirect zuba://redirect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: same iOS/Android OAuth client IDs as mobile (PKCE-only exchange; no secret)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Must match mobile canonical redirect (default zuba://redirect)
GOOGLE_OAUTH_REDIRECT_URI=zuba://redirect
# Comma-separated allow-list for dev/prod redirects.
GOOGLE_OAUTH_REDIRECT_URIS=zuba://redirect,com.zubahouse.customer:/oauthredirect
EXPO_OWNER=olivierndev
EXPO_SLUG=zuba-mobile
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_VISION_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=

# Stripe (required for mobile card checkout)
# Dashboard → Developers → API keys → Secret key (sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_
# Publishable key (pk_test_) goes in mobile/.env only — NOT here
STRIPE_CURRENCY=USD
CURRENCY=USD
# Webhook signing secret (whsec_) — endpoint: https://your-api/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Only for Stripe Connect / sk_org_ keys:
STRIPE_TARGET_ACCOUNT=
STRIPE_ACCOUNT=
PAYPAL_MODE=test
PAYPAL_CLIENT_ID_TEST=
PAYPAL_SECRET_TEST=
PAYPAL_CLIENT_ID_LIVE=
PAYPAL_SECRET_LIVE=

# Shipping + fallback calculations
EASYPOST_API_KEY=
FALLBACK_BASE_RATE=13
FALLBACK_EXTRA_ITEM=3

# Warehouse defaults (for shipping integrations)
WAREHOUSE_NAME=
WAREHOUSE_ADDRESS1=
WAREHOUSE_CITY=
WAREHOUSE_PROVINCE=
WAREHOUSE_POSTAL=
WAREHOUSE_COUNTRY=
WAREHOUSE_PHONE=

# Branding
ZUBA_LOGO_URL=
LOGO_URL=
