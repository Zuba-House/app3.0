{
  "expo": {
    "name": "Zuba",
    "owner": "olivierndev",
    "slug": "zuba-mobile",
    "version": "1.0.0",
    "scheme": "zuba",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#e8a87c",
          "androidMode": "default",
          "androidCollapsedTitle": "Zuba House"
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#e5e2db"
    },
    "ios": {
      "supportsTablet": true,
      "useFrameworks": "static",
      "bundleIdentifier": "com.zubahouse.customer",
      "googleServicesFile": "./GoogleService-Info.plist",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#e5e2db"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.zubahouse.customer",
      "enableProguardInReleaseBuilds": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b2735"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#e5e2db"
      }
    },
    "extra": {
      "apiUrl": "https://zuba-api.onrender.com",
      "expoOwner": "olivierndev",
      "expoSlug": "zuba-mobile",
      "eas": {
        "projectId": "b1c36a7f-6753-42dd-a363-8c673e354a69"
      }
    }
  }
}
