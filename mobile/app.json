{
  "expo": {
    "name": "Zuba",
    "owner": "olivierndev",
    "slug": "zuba-mobile",
    "version": "1.0.0",
    "scheme": "zuba",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-secure-store",
      "expo-web-browser"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#e5e2db"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zubahouse.customer",
      "googleServicesFile": "./GoogleService-Info.plist",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#e5e2db"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.zubahouse.customer",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b2735"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#e5e2db"
      }
    },
    "extra": {
      "apiUrl": "https://zuba-api.onrender.com",
      "googleOAuthRedirectPath": "redirect",
      "googleOAuthRedirectUri": "zuba://redirect",
      "expoOwner": "olivierndev",
      "expoSlug": "zuba-mobile",
      "eas": {
        "projectId": "zuba-house-019"
      },
      "expoClientId": "435369151234-8e7sb5ferci9ti2472vdmf6ose5e6nss.apps.googleusercontent.com",
      "googleWebClientId": "435369151234-8e7sb5ferci9ti2472vdmf6ose5e6nss.apps.googleusercontent.com",
      "googleIosClientId": "435369151234-8e7sb5ferci9ti2472vdmf6ose5e6nss.apps.googleusercontent.com",
      "googleAndroidClientId": "435369151234-8e7sb5ferci9ti2472vdmf6ose5e6nss.apps.googleusercontent.com"
    }
  }
}
