{
  "expo": {
    "name": "Zuba House",
    "owner": "olivierndev",
    "slug": "zuba-mobile",
    "version": "11.0.4",
    "scheme": "zuba",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "./plugins/withStripeCardOnly.js",
      "expo-secure-store",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#e8a87c",
          "androidMode": "default",
          "androidCollapsedTitle": "Zuba House"
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#e5e2db"
    },
    "ios": {
      "supportsTablet": true,
      "useFrameworks": "static",
      "bundleIdentifier": "ninja.wpapp.appzubahousecom",
      "googleServicesFile": "./GoogleService-Info.plist",
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#e5e2db"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "appzubahousecom.wpapp",
      "versionCode": 3,
      "enableProguardInReleaseBuilds": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#e5e2db"
      }
    },
    "extra": {
      "apiUrl": "https://zuba-api.onrender.com",
      "expoOwner": "olivierndev",
      "expoSlug": "zuba-mobile",
      "eas": {
        "projectId": "b1c36a7f-6753-42dd-a363-8c673e354a69"
      }
    }
  }
}
