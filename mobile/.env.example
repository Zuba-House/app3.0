# API (required)
EXPO_PUBLIC_API_URL=https://zuba-api.onrender.com

# Google OAuth (mobile)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Personal ngrok token for `expo start --tunnel` (get yours at dashboard.ngrok.com).
# Required if tunnel times out — do not reuse Expo's shared token in ~/.expo/ngrok.yml.
NGROK_AUTH_TOKEN=

# Stripe publishable key (live pk_live_… for production). Required for in-app card payments.
# NEVER put sk_live_ or sk_test_ secret keys here — server (Render) only.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
